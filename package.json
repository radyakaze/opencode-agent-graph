{
  "name": "opencode-agent-graph",
  "version": "1.0.1",
  "description": "Real-time dashboard for OpenCode multi-agent activity, sessions, status, and tool usage",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agents",
    "multi-agent",
    "agent-dashboard",
    "developer-tools",
    "observability"
  ],
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src public",
    "lint:fix": "oxlint --fix src public",
    "format": "oxfmt --write src public",
    "format:check": "oxfmt --check src public",
    "fix": "bun run format && bun run lint:fix",
    "check": "bun run format:check && bun run lint",
    "test": "bun test src",
    "changelog": "changelogen",
    "release": "changelogen --release --no-output"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "changelogen": "^0.6.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2"
  }
}
